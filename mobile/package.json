{
  "name": "estibordo-android-shell",
  "version": "1.0.0",
  "private": true,
  "description": "Camada Android da plataforma ESTIBORDO.",
  "scripts": {
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:run": "cap run android",
    "android:doctor": "cap doctor android",
    "android:assets": "node scripts/prepare-assets.mjs && npx @capacitor/assets generate --android --iconBackgroundColor '#061a2b' --iconBackgroundColorDark '#061a2b' --splashBackgroundColor '#061a2b' --splashBackgroundColorDark '#061a2b'",
    "android:configure": "node scripts/configure-android.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/core": "8.5.1",
    "@capacitor/app": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@capacitor/push-notifications": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "typescript": "^5.9.2",
    "@capacitor/assets": "^3.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
