+@media(max-width:700px){
+  .dashboardHeader{height:68px}
+  .dashboardHeaderInner{padding:0 12px}
+  .dashboardBrand{width:180px}
+  .dashboardActions a:not(.dashboardStudy){display:none}
+  .dashboardActions a,.dashboardActions button{padding:8px 10px}
+  .dashboardIntro{align-items:flex-start;flex-direction:column}
+  .performanceMetrics{grid-template-columns:1fr 1fr}
+  .performanceMetric:last-child{grid-column:1/-1}
+  .subjectPerformanceHeading{align-items:flex-start;flex-direction:column}
+  .subjectPerformanceHeading p{text-align:left;margin:0}
+  .subjectStats{grid-template-columns:1fr 1fr}
+  .priorityList li{grid-template-columns:auto 1fr}
+  .priorityList li>b{grid-column:2;text-align:left}
+  .studyPriority li{align-items:flex-start;flex-direction:column}
+  .studyPriority li small{text-align:left}
+}
