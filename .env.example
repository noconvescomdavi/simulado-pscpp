# PostgreSQL/Neon - configure na Vercel
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full

# Gere uma chave longa e aleatória (mínimo: 32 caracteres)
AUTH_SECRET=troque-por-uma-chave-aleatoria-muito-longa

# Novas sessões usam 30 dias por padrão. Máximo aceito pela aplicação: 90.
AUTH_SESSION_DAYS=30

# Opcional
NEXT_PUBLIC_SITE_NAME=SIMULADOS PSCPP


# Tutor IA ESTIBORDO — configure somente no servidor/Vercel
OPENAI_API_KEY=
# Modelo econômico recomendado para o tutor especializado
OPENAI_TUTOR_MODEL=gpt-5.6-luna
