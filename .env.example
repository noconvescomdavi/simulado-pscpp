# PostgreSQL/Neon - configure na Vercel
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full

# Gere uma chave longa e aleatória (mínimo: 32 caracteres)
AUTH_SECRET=troque-por-uma-chave-aleatoria-muito-longa

# Novas sessões usam 30 dias por padrão. Máximo aceito pela aplicação: 90.
AUTH_SESSION_DAYS=30

# URL pública de produção, sem barra no final
NEXT_PUBLIC_APP_URL=https://simulado-pscpp.vercel.app

# Mercado Pago — use credenciais do ambiente correspondente
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_MAX_INSTALLMENTS=12
MERCADO_PAGO_EXCLUDED_PAYMENT_TYPES=

# Plano anual ESTIBORDO. Valor em centavos. Ex.: 259900 = R$ 2.599,00
PSCPP_ANNUAL_PRICE_CENTS=259900
PSCPP_ANNUAL_PRODUCT_TITLE=ESTIBORDO — acesso por 365 dias
MERCADO_PAGO_STATEMENT_DESCRIPTOR=ESTIBORDO

# Opcional
NEXT_PUBLIC_SITE_NAME=ESTIBORDO
