  "questions": [
    {
      "id": "MAN-538",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.1",
      "topic": "Curva de giro",
      "difficulty": "Médio",
      "style": "Aplicada",
      "question": "O relatório de uma curva padrão traz somente o raio médio do trecho final, a duração da volta e o afastamento máximo da rota inicial. Que leituras faltam para verificar o critério de giro da IMO?",
      "options": [
        {
          "key": "A",
          "text": "As rotações de entrada e de saída."
        },
        {
          "key": "B",
          "text": "O tempo de resposta do leme e a velocidade final."
        },
        {
          "key": "C",
          "text": "A projeção longitudinal aos 90° de mudança de proa e a projeção transversal aos 180°."
        },
        {
          "key": "D",
          "text": "O arco total percorrido e a largura do navio."
        },
        {
          "key": "E",
          "text": "A taxa média de guinada e a velocidade máxima."
        }
      ],
      "correct_answer": "C",
      "explanation": "O critério usa o avanço e o diâmetro tático. Eles vêm da trajetória da meia-nau medida desde a ordem de leme e projetada nos eixos do rumo original nos instantes de 90° e 180°, respectivamente.",
      "source": {
        "author": "INTERNATIONAL MARITIME ORGANIZATION (IMO)",
        "title": "Standards for Ship Manoeuvrability",
        "edition": "Resolution MSC.137(76), 4 Dec. 2002",
        "locator": "Anexo 6, p. 3, §§ 4.2.2–4.2.4, e p. 5, § 5.3.1"
      },
