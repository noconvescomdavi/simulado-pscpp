    {
      "id": "MAN-591",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.1",
      "topic": "Curva de giro",
      "difficulty": "Médio",
      "style": "Conceitual",
      "question": "Nas condições de referência, a curva a boreste apresentou avanço de 4,3L e diâmetro tático de 5,1L. A curva a bombordo apresentou 4,6L e 4,9L. Qual avaliação está correta?",
      "options": [
        {
          "key": "A",
          "text": "Só boreste satisfaz os dois limites."
        },
        {
          "key": "B",
          "text": "Só bombordo satisfaz os dois limites."
        },
        {
          "key": "C",
          "text": "Ambas satisfazem porque cada uma atende a um dos limites."
        },
        {
          "key": "D",
          "text": "A média entre bordos deve ser usada para decidir o atendimento."
        },
        {
          "key": "E",
          "text": "Cada bordo excede um limite diferente."
        }
      ],
      "correct_answer": "E",
      "explanation": "Os máximos são 4,5L para o avanço e 5L para o diâmetro tático. Boreste excede o diâmetro. Bombordo excede o avanço. A resolução exige o ensaio para ambos os bordos.",
      "source": {
        "author": "INTERNATIONAL MARITIME ORGANIZATION (IMO)",
        "title": "Standards for Ship Manoeuvrability",
        "edition": "Resolution MSC.137(76), 4 Dec. 2002",
        "locator": "Anexo 6, p. 3, § 4.2.2, p. 4, § 5.2, e p. 5, § 5.3.1"
      },
