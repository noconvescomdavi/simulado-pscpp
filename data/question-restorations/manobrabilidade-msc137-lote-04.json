    {
      "id": "MAN-541",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.4",
      "topic": "Zigue-zague",
      "difficulty": "Médio",
      "style": "Aplicada",
      "question": "No zigue-zague 10°/10°, o operador quer aguardar a taxa de guinada zerar para dar o primeiro contraleme, apesar de a proa já ter chegado ao desvio programado. Qual é a ordem prevista?",
      "options": [
        {
          "key": "A",
          "text": "Aguardar a parada completa da guinada, então inverter o leme."
        },
        {
          "key": "B",
          "text": "Reduzir o leme para 5° no mesmo bordo."
        },
        {
          "key": "C",
          "text": "Manter o leme até passar pelo maior desvio de proa."
        },
        {
          "key": "D",
          "text": "Levar o leme a meio e esperar o regresso à proa inicial."
        },
        {
          "key": "E",
          "text": "Ordenar 10° para o bordo oposto ao atingir o desvio."
        }
      ],
      "correct_answer": "E",
      "explanation": "A taxa nula é condição da aproximação inicial. A segunda ordem ocorre no limiar de 10° de desvio de proa e inicia a reversão, mesmo que a guinada ainda prossiga por algum tempo.",
      "source": {
        "author": "INTERNATIONAL MARITIME ORGANIZATION (IMO)",
        "title": "Standards for Ship Manoeuvrability",
        "edition": "Resolution MSC.137(76), 4 Dec. 2002",
        "locator": "Anexo 6, p. 4, §§ 4.2.6.1–4.2.6.3"
      },
