    {
      "id": "MAN-593",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.3",
      "topic": "Diâmetro tático",
      "difficulty": "Médio",
      "style": "Conceitual",
      "question": "Duas curvas partiram da mesma posição e proa. Na mudança de proa de 180°, a meia-nau ocupou a mesma posição nas duas provas, embora uma trajetória tenha sido mais longa. Como se comparam os diâmetros táticos?",
      "options": [
        {
          "key": "A",
          "text": "São iguais."
        },
        {
          "key": "B",
          "text": "O maior corresponde à trajetória mais longa."
        },
        {
          "key": "C",
          "text": "O menor corresponde à trajetória mais longa."
        },
        {
          "key": "D",
          "text": "Um deles é indefinido sem a velocidade média."
        },
        {
          "key": "E",
          "text": "Um deles deve ser medido na mudança de proa de 360°."
        }
      ],
      "correct_answer": "A",
      "explanation": "O diâmetro tático é uma projeção transversal entre duas posições. Como as posições inicial e final e o rumo original coincidem, o diâmetro é o mesmo nos dois casos.",
