    {
      "id": "MAN-542",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.5",
      "topic": "Overshoot",
      "difficulty": "Médio",
      "style": "Aplicada",
      "question": "Em um zigue-zague 20°/20°, a segunda ordem foi dada na proa 060° e o primeiro extremo ocorreu em 085°. O navio tem L/V de 34 s. Qual é a conclusão sobre o primeiro sobressinal?",
      "options": [
        {
          "key": "A",
          "text": "Atende exatamente ao máximo."
        },
        {
          "key": "B",
          "text": "Excede seu máximo em 5°."
        },
        {
          "key": "C",
          "text": "Fica 5° abaixo de seu máximo."
        },
        {
          "key": "D",
          "text": "Excede seu máximo em 10°."
        },
        {
          "key": "E",
          "text": "Fica 15° abaixo de seu máximo."
        }
      ],
      "correct_answer": "A",
      "explanation": "O primeiro sobressinal é 85° − 60° = 25°. No ensaio 20°/20°, o máximo é 25° e não depende de L/V.",
      "source": {
        "author": "INTERNATIONAL MARITIME ORGANIZATION (IMO)",
        "title": "Standards for Ship Manoeuvrability",
        "edition": "Resolution MSC.137(76), 4 Dec. 2002",
