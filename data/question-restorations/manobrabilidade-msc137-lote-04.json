    {
      "id": "MAN-540",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.3",
      "topic": "Diâmetro tático",
      "difficulty": "Médio",
      "style": "Aplicada",
      "question": "Em uma curva padrão, a proa inicial era 045° verdadeiros. Quando a proa mudou 180°, a meia-nau estava 300 m a leste e 300 m ao sul da posição da ordem de leme. Quanto mede aproximadamente o diâmetro tático?",
      "options": [
        {
          "key": "A",
          "text": "0 m."
        },
        {
          "key": "B",
          "text": "300 m."
        },
        {
          "key": "C",
          "text": "424 m."
        },
        {
          "key": "D",
          "text": "600 m."
        },
        {
          "key": "E",
          "text": "850 m."
        }
      ],
      "correct_answer": "C",
      "explanation": "O deslocamento aponta para 135°, perpendicular ao rumo 045°. Seu módulo é a raiz de 300² + 300², aproximadamente 424 m. Toda a distância projetada é transversal nesse caso.",
      "source": {
        "author": "INTERNATIONAL MARITIME ORGANIZATION (IMO)",
        "title": "Standards for Ship Manoeuvrability",
        "edition": "Resolution MSC.137(76), 4 Dec. 2002",
        "locator": "Anexo 6, p. 3, §§ 4.1.2 e 4.2.4"
      },
