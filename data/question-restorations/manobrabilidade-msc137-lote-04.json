    {
      "id": "MAN-602",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.12",
      "topic": "Critérios IMO",
      "difficulty": "Difícil",
      "style": "Conceitual",
      "question": "No ensaio de parada de um navio de L = 140 m sem limite administrativo especial, a meia-nau percorre 2.170 m entre a ordem de toda força a ré e a parada na água. A separação em linha reta ficou em 2.030 m. Qual avaliação é correta?",
      "options": [
        {
          "key": "A",
          "text": "Atende com margem de 70 m medida em linha reta."
        },
        {
          "key": "B",
          "text": "Atende porque a medição deve excluir a trajetória curva."
        },
        {
          "key": "C",
          "text": "Atende porque o máximo é de 20L para todo navio."
        },
        {
          "key": "D",
          "text": "Excede o máximo em 70 m, medidos pelo percurso."
        },
