    {
      "id": "MAN-539",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.2",
      "topic": "Avanço",
      "difficulty": "Médio",
      "style": "Aplicada",
      "question": "A ordem de leme ocorreu na coordenada longitudinal −45 m. Na mudança de proa de 90°, a meia-nau estava em +355 m no mesmo eixo, orientado no rumo original. Qual foi o avanço?",
      "options": [
        {
          "key": "A",
          "text": "310 m."
        },
        {
          "key": "B",
          "text": "400 m."
        },
        {
          "key": "C",
          "text": "355 m."
        },
        {
          "key": "D",
          "text": "445 m."
        },
        {
          "key": "E",
          "text": "45 m."
        }
      ],
      "correct_answer": "B",
      "explanation": "O ponto de partida é a posição da ordem. A diferença entre as coordenadas longitudinais é 355 − (−45) = 400 m.",
      "source": {
        "author": "INTERNATIONAL MARITIME ORGANIZATION (IMO)",
        "title": "Standards for Ship Manoeuvrability",
        "edition": "Resolution MSC.137(76), 4 Dec. 2002",
