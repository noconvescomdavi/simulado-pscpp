    {
      "id": "MAN-548",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.11",
      "topic": "Condições de ensaio IMO",
      "difficulty": "Médio",
      "style": "Aplicada",
      "question": "A velocidade a 85% da potência máxima é 18 nós. A aproximação ficou estável em 15,8 nós e todos os demais requisitos de referência foram atendidos. Qual conclusão vale para a condição inicial?",
      "options": [
        {
          "key": "A",
          "text": "Atende porque 15,8 nós já está acima de 85% de 18 nós."
        },
        {
          "key": "B",
          "text": "Faltam 0,4 nó para o mínimo."
        },
        {
          "key": "C",
          "text": "Atende se a potência se mantiver constante."
        },
        {
          "key": "D",
          "text": "A aproximação precisa atingir exatamente 18 nós."
        },
        {
          "key": "E",
          "text": "Faltam 2,2 nós para o mínimo."
        }
      ],
      "correct_answer": "B",
      "explanation": "A velocidade de prova deve ser de pelo menos 90% de 18 nós, ou 16,2 nós. A aproximação de 15,8 nós fica 0,4 nó abaixo.",
      "source": {
