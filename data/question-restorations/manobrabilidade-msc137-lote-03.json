  "questions": [
    {
      "id": "MAN-432",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.1",
      "topic": "Curva de giro",
      "difficulty": "Médio",
      "style": "Conceitual",
      "question": "Na velocidade de teste, o maior ângulo admissível de leme é 32°. Uma curva experimental foi feita com 28° para cada bordo, em aproximação estabilizada. Com que ângulo as duas curvas devem ser refeitas?",
      "options": [
        {
          "key": "A",
          "text": "10°."
        },
        {
          "key": "B",
          "text": "20°."
        },
        {
          "key": "C",
          "text": "28°."
        },
        {
          "key": "D",
          "text": "32°."
        },
        {
          "key": "E",
          "text": "35°."
        }
      ],
      "correct_answer": "D",
      "explanation": "Se 35° não são admissíveis na velocidade de teste, usa-se o maior ângulo permitido para essa velocidade, que no caso é 32°.",
      "source": {
        "author": "INTERNATIONAL MARITIME ORGANIZATION (IMO)",
        "title": "Standards for Ship Manoeuvrability",
        "edition": "Resolution MSC.137(76), 4 Dec. 2002",
        "locator": "Anexo 6, p. 3, § 4.2.2"
      },
