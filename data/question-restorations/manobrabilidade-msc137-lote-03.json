    {
      "id": "MAN-434",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.3",
      "topic": "Diâmetro tático",
      "difficulty": "Difícil",
      "style": "Conceitual",
      "question": "O diâmetro tático medido na curva padrão foi 750 m, exatamente no limite da IMO. Qual é o comprimento entre perpendiculares do navio?",
