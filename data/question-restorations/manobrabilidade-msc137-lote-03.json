      "topic": "Overshoot",
      "difficulty": "Médio",
      "style": "Conceitual",
      "question": "No zigue-zague 10°/10°, um navio de L/V = 32 s obteve sobressinais de 23° e 39°, nessa ordem. Como ficam as duas leituras perante seus respectivos limites?",
      "options": [
        {
          "key": "A",
          "text": "A primeira excede e a segunda atende."
        },
        {
          "key": "B",
          "text": "A primeira atende e a segunda excede."
        },
        {
          "key": "C",
          "text": "Ambas atendem."
        },
        {
          "key": "D",
          "text": "Ambas excedem."
        },
        {
          "key": "E",
          "text": "A primeira coincide com o máximo e a segunda fica abaixo."
        }
      ],
      "correct_answer": "A",
      "explanation": "Com L/V a partir de 30 s, os máximos são 20° e 40°, respectivamente. O primeiro valor passa de 20° e o segundo fica aquém de 40°.",
