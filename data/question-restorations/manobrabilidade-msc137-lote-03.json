    {
      "id": "MAN-433",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.2",
      "topic": "Avanço",
      "difficulty": "Médio",
      "style": "Conceitual",
      "question": "Um navio mede 160 m entre perpendiculares e 175 m de comprimento total. O avanço medido foi 730 m. Qual é o saldo, em metros, da medição menos o máximo admitido pela MSC.137(76)?",
      "options": [
        {
          "key": "A",
          "text": "Menos 10 m."
        },
        {
          "key": "B",
          "text": "Menos 57,5 m."
        },
        {
          "key": "C",
          "text": "Mais 30 m."
        },
        {
          "key": "D",
          "text": "Mais 10 m."
        },
        {
          "key": "E",
          "text": "Menos 70 m."
        }
      ],
      "correct_answer": "D",
      "explanation": "O comprimento L é o medido entre perpendiculares. O avanço máximo é 4,5 × 160 = 720 m. A leitura supera o máximo em 10 m.",
      "source": {
        "author": "INTERNATIONAL MARITIME ORGANIZATION (IMO)",
        "title": "Standards for Ship Manoeuvrability",
        "edition": "Resolution MSC.137(76), 4 Dec. 2002",
        "locator": "Anexo 6, p. 3, § 4.1.1 e § 4.2.3, e p. 5, § 5.3.1"
      },
