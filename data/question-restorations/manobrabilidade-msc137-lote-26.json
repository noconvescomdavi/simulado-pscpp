    {
      "id": "MAN-2438",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.34",
      "topic": "Estabilidade direcional",
      "difficulty": "Médio",
      "style": "Aplicada",
      "question": "Num ensaio de governo em malha aberta, a equipe mantém a amplitude do leme e aumenta a frequência de sua oscilação. Que tendência a circular descreve para a oscilação correspondente da proa?",
      "options": [
        {
          "key": "A",
          "text": "A proa oscila mais, com menor defasagem."
        },
        {
          "key": "B",
          "text": "A proa conserva a amplitude e fica sem defasagem."
        },
        {
          "key": "C",
          "text": "A proa oscila menos e fica mais atrasada em relação ao leme."
        },
        {
          "key": "D",
          "text": "A proa passa a oscilar em frequência menor que a do leme."
        },
        {
          "key": "E",
          "text": "A proa fica estática em todo o intervalo de frequências."
        }
      ],
      "correct_answer": "C",
      "explanation": "A descrição em malha aberta mantém a frequência da resposta igual à da excitação. Inércia, amortecimento e atraso do aparelho reduzem a amplitude e aumentam a defasagem à medida que cresce a frequência.",
      "source": {
        "author": "INTERNATIONAL MARITIME ORGANIZATION (IMO)",
        "title": "Explanatory Notes to the Standards for Ship Manoeuvrability",
        "edition": "MSC/Circ.1053, 16 Dec. 2002",
        "locator": "Anexo, cap. 1, p. 4, § 1.2.2.10"
      },
