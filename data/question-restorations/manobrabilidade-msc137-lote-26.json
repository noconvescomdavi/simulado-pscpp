    {
      "id": "MAN-2439",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.35",
      "topic": "Curva espiral",
      "difficulty": "Médio",
      "style": "Aplicada",
      "question": "No gráfico da espiral direta, o eixo horizontal é o ângulo de leme e o vertical é a taxa de guinada. Para caracterizar a faixa de comandos em que os dois ramos coexistem, qual dimensão do laço deve ser lida?",
      "options": [
        {
          "key": "A",
          "text": "A altura, expressa em graus por segundo."
        },
        {
          "key": "B",
          "text": "A diagonal do retângulo que circunscreve o laço."
        },
        {
          "key": "C",
          "text": "O tempo decorrido entre as duas leituras de leme a meio."
        },
        {
          "key": "D",
          "text": "A largura horizontal, expressa em graus de leme."
        },
        {
          "key": "E",
          "text": "A área, expressa em metros quadrados."
        }
      ],
      "correct_answer": "D",
      "explanation": "A largura mede a extensão do laço no eixo do leme. A altura é uma dimensão diferente, no eixo da taxa de guinada.",
      "source": {
        "author": "SANTOS, Edson Mesquita dos",
        "title": "A Manobrabilidade do Navio no Século 21",
        "edition": "1ª ed., CONAPRA, 2021",
