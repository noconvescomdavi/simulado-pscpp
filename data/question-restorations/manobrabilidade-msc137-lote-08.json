  "questions": [
    {
      "id": "MAN-962",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.1",
      "topic": "Curva de giro",
      "difficulty": "Difícil",
      "style": "Situacional",
      "question": "O gráfico da curva foi construído com eixos geográficos leste e norte. A proa estabilizada na aproximação era 030° verdadeiros. Que direções devem definir os dois eixos das medidas padronizadas de giro?",
      "options": [
        {
          "key": "A",
          "text": "030°–210° e 120°–300°."
        },
        {
          "key": "B",
          "text": "000°–180° e 090°–270°."
        },
        {
          "key": "C",
          "text": "030°–210° e 060°–240°."
        },
        {
          "key": "D",
          "text": "120°–300° e 150°–330°."
        },
        {
          "key": "E",
          "text": "045°–225° e 135°–315°."
        }
      ],
      "correct_answer": "A",
      "explanation": "Os eixos são paralelo e perpendicular ao rumo original. Com referência inicial 030°, o eixo transversal fica a 120°–300°.",
      "source": {
        "author": "INTERNATIONAL MARITIME ORGANIZATION (IMO)",
        "title": "Standards for Ship Manoeuvrability",
        "edition": "Resolution MSC.137(76), 4 Dec. 2002",
        "locator": "Anexo 6, p. 3, §§ 4.2.2–4.2.4"
      },
