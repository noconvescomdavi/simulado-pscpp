    {
      "id": "MAN-965",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.4",
      "topic": "Zigue-zague",
      "difficulty": "Difícil",
      "style": "Situacional",
      "question": "Em um zigue-zague 10°/10°, um operador programou a primeira ordem para 10° a boreste e pretende usar sempre 10° de mudança desde a proa registrada na ordem imediatamente anterior. Que referência deve usar para as inversões?",
      "options": [
        {
          "key": "A",
          "text": "A proa estabilizada antes do primeiro comando."
        },
        {
          "key": "B",
          "text": "A proa registrada na última inversão."
        },
        {
          "key": "C",
          "text": "O menor rumo sobre o fundo já registrado."
        },
        {
          "key": "D",
          "text": "A projeção do vetor posição em relação ao eixo inicial."
        },
        {
          "key": "E",
          "text": "A proa mais extrema atingida antes de cada contraleme."
        }
      ],
      "correct_answer": "A",
      "explanation": "Os limiares são desvios de 10° para cada lado da proa inicial. A referência não se desloca depois de cada inversão.",
      "source": {
        "author": "INTERNATIONAL MARITIME ORGANIZATION (IMO)",
        "title": "Standards for Ship Manoeuvrability",
        "edition": "Resolution MSC.137(76), 4 Dec. 2002",
        "locator": "Anexo 6, pp. 3–4, §§ 4.2.5 e 4.2.6.1–4.2.6.3"
      },
