    {
      "id": "MAN-963",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.2",
      "topic": "Avanço",
      "difficulty": "Médio",
      "style": "Situacional",
      "question": "Na curva de giro, o deslocamento longitudinal a partir da ordem foi 541 m aos 88° e 549 m aos 92° de mudança de proa. Admitindo interpolação linear entre essas duas amostras, qual leitura estima o avanço?",
      "options": [
        {
          "key": "A",
          "text": "541 m."
        },
        {
          "key": "B",
          "text": "549 m."
        },
        {
          "key": "C",
          "text": "540 m."
        },
        {
          "key": "D",
          "text": "545 m."
        },
        {
          "key": "E",
          "text": "552 m."
        }
      ],
      "correct_answer": "D",
      "explanation": "A mudança de proa de 90° está no meio do intervalo. A interpolação linear entre 541 m e 549 m dá 545 m.",
      "source": {
        "author": "INTERNATIONAL MARITIME ORGANIZATION (IMO)",
        "title": "Standards for Ship Manoeuvrability",
        "edition": "Resolution MSC.137(76), 4 Dec. 2002",
