          "text": "A primeira apenas."
        },
        {
          "key": "B",
          "text": "A segunda apenas."
        },
        {
          "key": "C",
          "text": "A terceira apenas."
        },
        {
          "key": "D",
          "text": "A primeira e a terceira."
        },
        {
          "key": "E",
          "text": "Nenhuma delas."
        }
      ],
      "correct_answer": "C",
