    {
      "id": "MAN-1029",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.29",
      "topic": "Curva de giro",
      "difficulty": "Fácil",
      "style": "Normativa",
      "question": "No planejamento da curva de giro da IMO, uma execução está prevista a boreste e outra a bombordo. O ângulo admissível e a velocidade de teste são os mesmos para as duas. Qual condição inicial serve aos dois ensaios?",
      "options": [
        {
          "key": "A",
          "text": "Começar com a guinada estabelecida para o lado da curva."
        },
        {
          "key": "B",
          "text": "Usar o instante de menor velocidade da aproximação."
        },
        {
          "key": "C",
          "text": "Aguardar até que a razão de guinada pare de aumentar, mesmo se for positiva."
        },
        {
          "key": "D",
          "text": "Estabilizar a aproximação com taxa de guinada igual a zero."
        },
        {
          "key": "E",
          "text": "Compensar a guinada inicial com leme oposto após a ordem de giro."
        }
      ],
      "correct_answer": "D",
      "explanation": "Segundo a definição do ensaio, a ordem de leme vem após aproximação estabilizada e taxa de guinada nula. A condição vale para ambos os bordos.",
      "source": {
        "author": "INTERNATIONAL MARITIME ORGANIZATION (IMO)",
        "title": "Standards for Ship Manoeuvrability",
        "edition": "Resolution MSC.137(76), 4 Dec. 2002",
        "locator": "Anexo 6, p. 3, § 4.2.2, e p. 4, §§ 5.2.1–5.2.4"
      },
