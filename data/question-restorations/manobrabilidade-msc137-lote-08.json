    {
      "id": "MAN-964",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.3",
      "topic": "Diâmetro tático",
      "difficulty": "Difícil",
      "style": "Situacional",
      "question": "A aproximação para uma curva a boreste foi na proa 045° verdadeiros. A meia-nau se deslocou 800 m a leste e 100 m ao norte até a primeira mudança de proa de 180°. Qual é aproximadamente a projeção transversal à direção inicial?",
      "options": [
        {
          "key": "A",
          "text": "636 m."
        },
        {
          "key": "B",
          "text": "495 m."
        },
        {
          "key": "C",
          "text": "806 m."
        },
        {
          "key": "D",
          "text": "700 m."
        },
        {
          "key": "E",
          "text": "900 m."
        }
      ],
      "correct_answer": "B",
      "explanation": "A direção transversal a boreste é 135°. A projeção é 800 × sen(135°) + 100 × cos(135°), cerca de 495 m.",
      "source": {
        "author": "INTERNATIONAL MARITIME ORGANIZATION (IMO)",
        "title": "Standards for Ship Manoeuvrability",
        "edition": "Resolution MSC.137(76), 4 Dec. 2002",
        "locator": "Anexo 6, p. 3, §§ 4.1.2 e 4.2.4"
      },
