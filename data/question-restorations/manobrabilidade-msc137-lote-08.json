    {
      "id": "MAN-972",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.11",
      "topic": "Condições de ensaio IMO",
      "difficulty": "Difícil",
      "style": "Situacional",
      "question": "A velocidade do navio a 85% da potência máxima é 17,0 nós. O ensaio começou após aproximação estável a 15,6 nós e com as demais condições de referência atendidas. Qual análise da velocidade de prova está correta?",
      "options": [
        {
          "key": "A",
          "text": "Faltaram 1,4 nós, pois são exigidos 17,0 nós."
        },
        {
          "key": "B",
          "text": "A velocidade só seria aceitável com a potência máxima aplicada."
        },
        {
          "key": "C",
          "text": "A leitura supera o mínimo de 15,3 nós em 0,3 nó."
        },
        {
          "key": "D",
          "text": "A leitura fica 0,3 nó abaixo do mínimo de 15,9 nós."
        },
        {
          "key": "E",
          "text": "A leitura atende porque o limiar equivale a 85% de 17,0 nós."
        }
      ],
      "correct_answer": "C",
      "explanation": "O mínimo é 0,90 × 17,0 = 15,3 nós. A aproximação de 15,6 nós está 0,3 nó acima desse valor.",
      "source": {
