    {
      "id": "MAN-330",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.5",
      "topic": "Overshoot",
      "difficulty": "Fácil",
      "style": "Conceitual",
      "question": "No zigue-zague, por que é preciso registrar a proa após a ordem de contraleme para medir o sobressinal?",
      "options": [
        {
          "key": "A",
          "text": "Porque a distância longitudinal percorrida define o sobressinal."
        },
        {
          "key": "B",
          "text": "Porque a ordem de contraleme define a proa extrema naquele instante."
        },
        {
          "key": "C",
          "text": "Porque se deve usar a deflexão máxima do leme no lugar da leitura de proa."
        },
        {
          "key": "D",
          "text": "Porque a guinada ainda pode prosseguir na direção anterior antes de se inverter."
        },
        {
          "key": "E",
          "text": "Porque o sobressinal se mede apenas após o navio repetir o rumo de aproximação."
        }
      ],
      "correct_answer": "D",
      "explanation": "Depois do contraleme, a taxa de guinada decresce antes de inverter de sinal. O desvio de proa adicional nesse intervalo é o sobressinal associado à execução.",
      "source": {
        "author": "INTERNATIONAL MARITIME ORGANIZATION (IMO)",
        "title": "Standards for Ship Manoeuvrability",
        "edition": "Resolution MSC.137(76), 4 Dec. 2002",
        "locator": "Anexo 6, p. 4, § 4.2.6.3 e §§ 4.2.7–4.2.8"
      },
