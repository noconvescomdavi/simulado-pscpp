    {
      "id": "MAN-328",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.3",
      "topic": "Diâmetro tático",
      "difficulty": "Difícil",
      "style": "Conceitual",
      "question": "A trajetória da meia-nau tem seu maior afastamento lateral do rumo inicial quando a proa já mudou mais de 180°. Qual leitura representa o diâmetro tático?",
      "options": [
        {
          "key": "A",
          "text": "O maior afastamento lateral observado, independentemente da proa."
        },
        {
          "key": "B",
          "text": "O deslocamento no sentido do rumo inicial quando a proa mudou 180°."
        },
        {
          "key": "C",
          "text": "O afastamento lateral na primeira passagem da proa por 180° de mudança."
        },
        {
          "key": "D",
          "text": "O comprimento do arco percorrido até a mudança de proa de 180°."
        },
        {
          "key": "E",
          "text": "O afastamento lateral quando a proa mudou 90°."
        }
      ],
      "correct_answer": "C",
      "explanation": "Meça a projeção perpendicular ao rumo inicial entre a posição da ordem de leme e a posição atingida ao mudar a proa em 180°. O máximo afastamento pode ocorrer em outro instante.",
      "source": {
        "author": "INTERNATIONAL MARITIME ORGANIZATION (IMO)",
        "title": "Standards for Ship Manoeuvrability",
        "edition": "Resolution MSC.137(76), 4 Dec. 2002",
        "locator": "Anexo 6, p. 3, § 4.2.4"
      },
