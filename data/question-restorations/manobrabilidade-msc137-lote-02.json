  "questions": [
    {
      "id": "MAN-327",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.2",
      "topic": "Avanço",
      "difficulty": "Médio",
      "style": "Conceitual",
      "question": "Na curva de giro padrão, qual ponto do navio deve servir de referência para a trajetória usada na medição do avanço?",
      "options": [
        {
          "key": "A",
          "text": "O ponto na linha de centro a meio caminho entre as perpendiculares de vante e de ré."
        },
        {
          "key": "B",
          "text": "A posição instantânea do ponto pivô na guinada."
        },
        {
          "key": "C",
          "text": "O eixo da madre do leme."
        },
        {
          "key": "D",
          "text": "O centro da área vélica acima da linha d’água."
        },
        {
          "key": "E",
          "text": "Uma antena GNSS instalada na proa, sem compensar sua posição."
        }
      ],
      "correct_answer": "A",
      "explanation": "A norma mede o avanço pela trajetória do ponto de meia-nau definido entre as perpendiculares de vante e de ré. A posição da antena, quando diferente, precisa ser referida a esse ponto.",
      "source": {
        "author": "INTERNATIONAL MARITIME ORGANIZATION (IMO)",
        "title": "Standards for Ship Manoeuvrability",
        "edition": "Resolution MSC.137(76), 4 Dec. 2002",
        "locator": "Anexo 6, p. 3, § 4.1.2 e § 4.2.3"
      },
