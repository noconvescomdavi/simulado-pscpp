    {
      "id": "MAN-336",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.11",
      "topic": "Condições de ensaio IMO",
      "difficulty": "Médio",
      "style": "Conceitual",
      "question": "Um navio em plena carga, sem trim e com aproximação estabilizada na velocidade de prova ensaia em uma enseada calma, porém de pouca profundidade. Que condição de referência falta atender?",
      "options": [
        {
          "key": "A",
          "text": "Ausência de banda estática de qualquer magnitude."
        },
        {
          "key": "B",
          "text": "Avante a 100% da potência máxima do motor."
        },
        {
          "key": "C",
          "text": "Calado igual à metade do calado de verão."
        },
        {
          "key": "D",
          "text": "Águas profundas e sem restrições."
        },
        {
          "key": "E",
          "text": "Proa inicial obrigatoriamente alinhada com o norte verdadeiro."
        }
      ],
      "correct_answer": "D",
      "explanation": "A calmaria e as condições de carregamento e velocidade descritas não compensam a pouca profundidade. O § 5.2.1 exige águas profundas e sem restrições.",
