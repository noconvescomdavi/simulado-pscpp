      "id": "MAN-B001-01",
      "subject": "I — Manobrabilidade do Navio",
      "module": "Pressão dinâmica",
      "topic_code": "MAN.B001.01",
      "topic": "Pressão dinâmica",
      "difficulty": "Difícil",
      "style": "Aplicada",
      "pscpp_format": "situation",
      "cognitive_level": 4,
      "question": "Um navio entra em uma área onde a velocidade relativa da água junto ao casco dobra, mantendo-se a densidade. Desprezadas mudanças de geometria, qual tendência decorre da relação apresentada por Crenshaw para a pressão dinâmica?",
      "options": [
        {
          "key": "A",
          "text": "Quadruplica."
        },
        {
          "key": "B",
          "text": "Permanece constante."
        },
        {
          "key": "C",
          "text": "Dobra."
        },
        {
          "key": "D",
          "text": "Cai à metade."
        },
        {
          "key": "E",
          "text": "Aumenta oito vezes."
        }
      ],
      "correct_answer": "A",
      "explanation": "A pressão dinâmica é proporcional ao quadrado da velocidade local do escoamento. Com a mesma densidade, a razão é 2² = 4.",
      "active": true,
      "validation_status": "approved",
