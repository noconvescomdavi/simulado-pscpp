    {
      "id": "MAN-1083",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.29",
      "topic": "Curva de giro",
      "difficulty": "Médio",
      "style": "Aplicada",
      "question": "Um relatório atribui à curva de giro dois resultados: projeção transversal a 180° de 5,2L e projeção longitudinal a 90° de 4,3L. Qual classificação associa corretamente cada medida a seu limite?",
      "options": [
        {
          "key": "A",
          "text": "Ambas são avanços e devem ser inferiores ou iguais a 4,5L."
        },
        {
          "key": "B",
          "text": "A primeira é avanço dentro do limite e a segunda é diâmetro tático acima do limite."
        },
        {
          "key": "C",
          "text": "A primeira é diâmetro tático acima do limite e a segunda é avanço dentro do limite."
        },
        {
          "key": "D",
          "text": "Ambas estão dentro do limite, pois a média das leituras é inferior a 5L."
        },
        {
          "key": "E",
          "text": "A primeira é distância de parada dentro do limite e a segunda é avanço acima do limite."
        }
      ],
      "correct_answer": "C",
      "explanation": "A componente transversal aos 180° é diâmetro tático e deve ser até 5L. A componente longitudinal aos 90° é avanço e deve ser até 4,5L.",
      "source": {
        "author": "INTERNATIONAL MARITIME ORGANIZATION (IMO)",
        "title": "Standards for Ship Manoeuvrability",
        "edition": "Resolution MSC.137(76), 4 Dec. 2002",
