  "questions": [
    {
      "id": "MAN-1037",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.37",
      "topic": "Movimento a ré",
      "difficulty": "Fácil",
      "style": "Normativa",
      "question": "Em um navio de propulsão convencional, ainda com seguimento avante, a rotação do propulsor é revertida para iniciar a parada. Como essa mudança pode afetar o leme usado para manter o aproamento?",
      "options": [
        {
          "key": "A",
          "text": "O leme passa a ter necessariamente a mesma ação estabilizadora de antes."
        },
        {
          "key": "B",
          "text": "As forças no leme podem enfraquecer e tornar-se irregulares."
        },
        {
          "key": "C",
          "text": "A vazão no leme aumenta em qualquer regime de operação."
        },
        {
          "key": "D",
          "text": "A guinada é determinada unicamente pelo ângulo indicado na roda do leme."
        },
        {
          "key": "E",
          "text": "O leme se torna mais eficaz à medida que a rotação a ré começa a subir, em todos os navios."
        }
      ],
      "correct_answer": "B",
      "explanation": "A reversão muda o escoamento incidente sobre casco, propulsor e leme. No regime descrito por Santos, a ação do leme pode ficar fraca e errática, o que prejudica manter a proa.",
      "source": {
        "author": "SANTOS, Edson Mesquita dos",
        "title": "A Manobrabilidade do Navio no Século 21",
        "edition": "1ª ed., CONAPRA, 2021",
        "locator": "cap. 7, § 7.3.2, pp. 120–121 impressas"
