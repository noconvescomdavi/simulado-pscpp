    {
      "id": "MAN-1896",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.32",
      "topic": "Zigue-zague",
      "difficulty": "Difícil",
      "style": "Aplicada",
      "question": "Para o mesmo L/V de 32 s, o primeiro sobressinal é de 21° no zigue-zague 10°/10° e de 24° no 20°/20°. Qual avaliação aplica os limites de cada prova?",
      "options": [
        {
          "key": "A",
          "text": "O primeiro resultado excede seu limite e o segundo atende ao seu."
        },
        {
          "key": "B",
          "text": "Ambos atendem porque são inferiores a 25°."
        },
        {
          "key": "C",
          "text": "Ambos excedem porque são superiores a 20°."
        },
        {
          "key": "D",
          "text": "Só o primeiro resultado atende."
        },
        {
          "key": "E",
          "text": "A resolução manda usar a média dos dois resultados."
        }
      ],
      "correct_answer": "A",
      "explanation": "Com L/V ≥ 30 s, o máximo no 10°/10° é 20°. No 20°/20° o máximo do primeiro sobressinal é 25°. A leitura de 21° excede, enquanto a de 24° atende.",
      "source": {
        "author": "INTERNATIONAL MARITIME ORGANIZATION (IMO)",
        "title": "Standards for Ship Manoeuvrability",
        "edition": "Resolution MSC.137(76), 4 Dec. 2002",
        "locator": "Anexo 6, p. 5, §§ 5.3.3.1–5.3.3.3"
