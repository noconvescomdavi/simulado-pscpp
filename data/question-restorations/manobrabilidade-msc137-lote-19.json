    {
      "id": "MAN-1898",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.34",
      "topic": "Estabilidade direcional",
      "difficulty": "Médio",
      "style": "Aplicada",
      "question": "Em malha aberta, o leme oscila com a mesma amplitude em duas frequências. Na segunda, a frequência é maior. Segundo a circular, qual tendência se espera para a amplitude da resposta de proa?",
      "options": [
        {
          "key": "A",
          "text": "Ela aumenta na mesma proporção da frequência."
        },
        {
          "key": "B",
          "text": "Ela fica igual porque a deflexão de leme tem a mesma amplitude."
        },
        {
          "key": "C",
          "text": "Ela diminui com o aumento da frequência."
        },
        {
          "key": "D",
          "text": "Ela se torna igual ao diâmetro tático."
        },
        {
          "key": "E",
          "text": "Ela muda somente se houver alteração na potência da máquina."
        }
      ],
      "correct_answer": "C",
      "explanation": "O § 1.2.2.10 associa maior frequência de excitação à menor amplitude de resposta de proa, considerando inércia, amortecimento e atrasos no acionamento.",
      "source": {
        "author": "INTERNATIONAL MARITIME ORGANIZATION (IMO)",
        "title": "Explanatory Notes to the Standards for Ship Manoeuvrability",
        "edition": "MSC/Circ.1053, 16 Dec. 2002",
