    {
      "id": "MAN-1897",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.33",
      "topic": "Primeiro sobressinal",
      "difficulty": "Fácil",
      "style": "Aplicada",
      "question": "Após a primeira inversão do leme, a proa ainda varia no mesmo sentido até um extremo e depois começa a retornar. Qual é o evento que encerra a medida do primeiro sobressinal?",
      "options": [
        {
          "key": "A",
          "text": "O cruzamento da proa inicial no retorno."
        },
        {
          "key": "B",
          "text": "O extremo atingido antes de a guinada mudar de sentido."
        },
        {
          "key": "C",
          "text": "A terceira ordem de leme."
        },
        {
          "key": "D",
          "text": "O instante em que a máquina é revertida."
        },
        {
          "key": "E",
          "text": "O cruzamento da proa de referência na aproximação."
        }
      ],
      "correct_answer": "B",
      "explanation": "O primeiro sobressinal termina no extremo de proa que se segue à primeira inversão. O retorno posterior não integra o desvio adicional medido.",
