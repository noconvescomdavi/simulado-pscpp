    {
      "id": "MAN-2703",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.29",
      "topic": "Curva de giro",
      "difficulty": "Médio",
      "style": "Aplicada",
      "question": "Depois de estabilizado o giro, a meia-nau percorre 660 m ao longo de meia circunferência. Adotando π = 3,14, qual diâmetro caracteriza o círculo em regime, arredondado ao metro?",
      "options": [
        {
          "key": "A",
          "text": "105 m."
        },
        {
          "key": "B",
          "text": "210 m."
        },
        {
          "key": "C",
          "text": "420 m."
        },
        {
          "key": "D",
          "text": "660 m."
        },
        {
          "key": "E",
          "text": "1.320 m."
        }
      ],
      "correct_answer": "C",
      "explanation": "Meia circunferência tem comprimento πR. Logo, R = 660/3,14 ≈ 210 m e o diâmetro de giro permanente é aproximadamente 420 m.",
      "source": {
        "author": "SANTOS, Edson Mesquita dos",
        "title": "A manobrabilidade do navio no século 21",
        "edition": "1. ed., 2021",
        "locator": "1ª ed., 2021, cap. 6, §§ 6.1 e 6.3.3, pp. 105 e 109 impressas"
      },
