    {
      "id": "MAN-2707",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.33",
      "topic": "Primeiro sobressinal",
      "difficulty": "Médio",
      "style": "Aplicada",
      "question": "Para o primeiro sobressinal no 10°/10°, o relatório calculou 10° como limite de um navio de L = 100 m e V = 10 m/s. Em qual faixa da MSC.137(76) deve ser registrado esse cálculo?",
      "options": [
        {
          "key": "A",
          "text": "Na faixa L/V menor que 10 s."
        },
        {
          "key": "B",
          "text": "Na faixa que começa em 10 s e vai até menos de 30 s."
        },
        {
          "key": "C",
          "text": "Na faixa que começa em 30 s."
        },
        {
          "key": "D",
          "text": "Na faixa fixa do 20°/20°."
        },
        {
          "key": "E",
          "text": "Em nenhuma faixa, porque L/V fica sem unidade."
        }
      ],
      "correct_answer": "B",
      "explanation": "L/V = 10 s exatamente. A faixa intermediária inclui a fronteira inferior e dá 5 + 0,5 × 10 = 10°. O resultado numérico coincide com o da faixa inferior, mas o enquadramento é diferente.",
      "source": {
        "author": "INTERNATIONAL MARITIME ORGANIZATION (IMO)",
        "title": "Standards for Ship Manoeuvrability",
        "edition": "Resolution MSC.137(76), 4 Dec. 2002",
        "locator": "Anexo 6, p. 5, §§ 5.3.3.1.1–.3"
