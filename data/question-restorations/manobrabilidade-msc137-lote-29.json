    {
      "id": "MAN-2706",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.32",
      "topic": "Zigue-zague",
      "difficulty": "Médio",
      "style": "Aplicada",
      "question": "Num zigue-zague 20°/20°, o primeiro comando é de 20° a boreste, com proa inicial de 120°. Na proa 130°, a máquina do leme já concluiu o movimento comandado. Qual é a próxima ordem de leme no procedimento?",
      "options": [
        {
          "key": "A",
          "text": "20° a bombordo na proa 140°."
        },
        {
          "key": "B",
          "text": "20° a bombordo na proa 130°."
        },
        {
          "key": "C",
          "text": "20° a bombordo na proa 120°."
        },
        {
          "key": "D",
          "text": "10° a bombordo na proa 140°."
        },
        {
          "key": "E",
          "text": "20° a boreste na proa 140°."
        }
      ],
      "correct_answer": "A",
      "explanation": "A primeira inversão ocorre quando a proa se afasta 20° da referência, em 140°. Troca-se o bordo mantendo o módulo de 20°.",
      "source": {
        "author": "INTERNATIONAL MARITIME ORGANIZATION (IMO)",
        "title": "Standards for Ship Manoeuvrability",
        "edition": "Resolution MSC.137(76), 4 Dec. 2002",
