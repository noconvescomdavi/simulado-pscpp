    {
      "id": "MAN-2704",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.30",
      "topic": "Avanço na curva de giro",
      "difficulty": "Difícil",
      "style": "Aplicada",
      "question": "Uma curva para boreste começa com proa 300°. A projeção longitudinal da meia-nau é 385 m em 020°, 402 m em 030° e 418 m em 040°, sempre medida desde a ordem de leme no eixo inicial. Qual projeção representa o avanço?",
      "options": [
        {
          "key": "A",
          "text": "385 m."
        },
        {
          "key": "B",
          "text": "418 m."
        },
        {
          "key": "C",
          "text": "33 m."
        },
        {
          "key": "D",
          "text": "402 m."
        },
        {
          "key": "E",
          "text": "803 m."
        }
      ],
      "correct_answer": "D",
      "explanation": "O marco de 90° de mudança é 300° + 90° = 390°, equivalente a 030°. Nesse marco, a projeção longitudinal é de 402 m.",
      "source": {
        "author": "INTERNATIONAL MARITIME ORGANIZATION (IMO)",
        "title": "Standards for Ship Manoeuvrability",
        "edition": "Resolution MSC.137(76), 4 Dec. 2002",
        "locator": "Anexo 6, p. 3, §§ 4.1.2 e 4.2.3"
      },
