    {
      "id": "MAN-2708",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.34",
      "topic": "Estabilidade direcional",
      "difficulty": "Difícil",
      "style": "Aplicada",
      "question": "Para investigar estabilidade direcional, um laboratório quer estimar os coeficientes hidrodinâmicos de deriva e guinada mediante movimentos impostos a um modelo. Em que tipo de ensaio a circular enquadra essa estratégia?",
      "options": [
        {
          "key": "A",
          "text": "Em ensaio de avanço a toda força com modelo livre apenas."
        },
        {
          "key": "B",
          "text": "Em teste cativo que apenas mede a altura metacêntrica."
        },
        {
          "key": "C",
          "text": "Em ensaio com modelo cativo, capaz de separar respostas a componentes de movimento."
        },
        {
          "key": "D",
          "text": "Em prova de parada no mar, sem registrar forças."
        },
        {
          "key": "E",
          "text": "Em teste estático com casco imobilizado, sem carregamentos laterais."
        }
      ],
      "correct_answer": "C",
      "explanation": "O modelo cativo permite impor modos de movimento como deriva e guinada. A análise das forças medidas identifica os coeficientes para o modelo matemático.",
      "source": {
        "author": "INTERNATIONAL MARITIME ORGANIZATION (IMO)",
        "title": "Explanatory Notes to the Standards for Ship Manoeuvrability",
        "edition": "MSC/Circ.1053, 16 Dec. 2002",
