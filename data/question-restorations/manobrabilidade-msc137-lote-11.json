    {
      "id": "MAN-1245",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.29",
      "topic": "Curva de giro",
      "difficulty": "Fácil",
      "style": "Conceitual",
      "question": "Para preparar a curva de giro padronizada, foi medida velocidade de 20 nós a 85% da potência máxima do motor. Qual é a menor velocidade de teste que atende à definição da MSC.137(76)?",
      "options": [
        {
          "key": "A",
          "text": "15 nós."
        },
        {
          "key": "B",
          "text": "16 nós."
        },
        {
          "key": "C",
          "text": "17 nós."
        },
        {
          "key": "D",
          "text": "20 nós."
        },
        {
          "key": "E",
          "text": "18 nós."
        }
      ],
      "correct_answer": "E",
      "explanation": "A velocidade de teste é de pelo menos 90% da velocidade que corresponde a 85% da potência máxima. Como 0,90 × 20 = 18 nós, esse é o menor valor.",
      "source": {
        "author": "INTERNATIONAL MARITIME ORGANIZATION (IMO)",
        "title": "Standards for Ship Manoeuvrability",
        "edition": "Resolution MSC.137(76), 4 Dec. 2002",
        "locator": "Anexo 6, pp. 3–4, §§ 4.2.1–4.2.2 e 5.2.4"
      },
