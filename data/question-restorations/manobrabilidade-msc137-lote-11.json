          "key": "A",
          "text": "Encerrar a manobra nesse ponto."
        },
        {
          "key": "B",
          "text": "Passar obrigatoriamente para o terceiro ponto."
        },
        {
          "key": "C",
          "text": "Classificar a instabilidade como acima do limite."
        },
        {
          "key": "D",
          "text": "Substituir o registro por um valor de velocidade do navio."
