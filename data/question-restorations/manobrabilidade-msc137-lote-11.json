    {
      "id": "MAN-1246",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.30",
      "topic": "Avanço na curva de giro",
      "difficulty": "Médio",
      "style": "Conceitual",
      "question": "Em um giro, decorrem alguns segundos entre a ordem de leme e a chegada do leme ao ângulo ordenado. Qual evento fixa a posição inicial para calcular o avanço?",
      "options": [
        {
          "key": "A",
          "text": "O instante em que se manda aplicar leme."
        },
        {
          "key": "B",
          "text": "O fim da movimentação do leme."
        },
        {
          "key": "C",
          "text": "O pico da taxa de guinada."
        },
        {
          "key": "D",
          "text": "A primeira queda de velocidade."
        },
        {
          "key": "E",
          "text": "O desvio de proa de 10°."
        }
      ],
      "correct_answer": "A",
      "explanation": "A posição inicial é a da meia-nau quando a ordem de leme é dada. Usar o instante em que o leme atinge a posição comandada exclui parte do deslocamento.",
      "source": {
        "author": "INTERNATIONAL MARITIME ORGANIZATION (IMO)",
        "title": "Standards for Ship Manoeuvrability",
        "edition": "Resolution MSC.137(76), 4 Dec. 2002",
        "locator": "Anexo 6, p. 3, § 4.2.3"
