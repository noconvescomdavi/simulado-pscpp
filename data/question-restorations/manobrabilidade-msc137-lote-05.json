    {
      "id": "MAN-645",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.2",
      "topic": "Avanço",
      "difficulty": "Médio",
      "style": "Situacional",
      "question": "Em um gráfico à escala de 1 cm para 100 m, a projeção longitudinal da meia-nau aos 90° de mudança de proa mede 8,2 cm a partir da ordem de leme. L vale 180 m. Como essa leitura se compara ao critério de avanço?",
      "options": [
        {
          "key": "A",
          "text": "Fica 80 m abaixo do máximo."
        },
        {
          "key": "B",
          "text": "Fica 10 m acima do máximo."
        },
        {
          "key": "C",
          "text": "Fica 10 m abaixo do máximo."
        },
        {
          "key": "D",
          "text": "Coincide com o máximo."
        },
        {
          "key": "E",
          "text": "Fica 370 m acima do máximo."
        }
      ],
      "correct_answer": "B",
      "explanation": "A leitura vale 820 m. O avanço máximo é 4,5 × 180 = 810 m, de modo que a diferença é um excesso de 10 m.",
      "source": {
        "author": "INTERNATIONAL MARITIME ORGANIZATION (IMO)",
        "title": "Standards for Ship Manoeuvrability",
        "edition": "Resolution MSC.137(76), 4 Dec. 2002",
        "locator": "Anexo 6, p. 3, § 4.2.3, e p. 5, § 5.3.1"
