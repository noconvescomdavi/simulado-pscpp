  "questions": [
    {
      "id": "MAN-644",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.1",
      "topic": "Curva de giro",
      "difficulty": "Fácil",
      "style": "Situacional",
      "question": "O gráfico de uma curva padrão só começa 12 segundos após o início da manobra. Mesmo com as posições relativas às mudanças de proa de 90° e 180°, falta um ponto de origem. Qual evento deve definir esse ponto?",
      "options": [
        {
          "key": "A",
          "text": "Estabilização na velocidade de prova."
        },
        {
          "key": "B",
          "text": "Conclusão de duas voltas."
        },
        {
          "key": "C",
          "text": "Primeiro comando de leme destinado a provocar o giro."
        },
        {
          "key": "D",
          "text": "Pico da taxa de guinada."
        },
        {
          "key": "E",
          "text": "Retorno à proa original após uma volta."
        }
      ],
      "correct_answer": "C",
      "explanation": "As duas projeções começam na posição da meia-nau na ordem de leme. Iniciar o gráfico mais tarde deixa essa origem desconhecida, mesmo com as duas posições finais registradas.",
      "source": {
        "author": "INTERNATIONAL MARITIME ORGANIZATION (IMO)",
        "title": "Standards for Ship Manoeuvrability",
        "edition": "Resolution MSC.137(76), 4 Dec. 2002",
        "locator": "Anexo 6, p. 3, §§ 4.2.3–4.2.4"
      },
