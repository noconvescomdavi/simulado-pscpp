    {
      "id": "MAN-697",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.1",
      "topic": "Curva de giro",
      "difficulty": "Médio",
      "style": "Aplicada",
      "question": "Um navio de 130 m já sujeito ao padrão recebe um leme de outro perfil após a prova original de giro. A Administração entende que a alteração pode afetar suas características em manobra. Que exigência passa a valer para a avaliação?",
      "options": [
        {
          "key": "A",
          "text": "Presumir a conformidade anterior enquanto a potência instalada não mudar."
        },
        {
          "key": "B",
          "text": "Verificar se o navio continua a atender aos padrões."
        },
        {
          "key": "C",
          "text": "Reavaliar apenas se seu comprimento passar de 200 m."
        },
        {
          "key": "D",
          "text": "Aceitar a conformidade anterior se o novo leme tiver a mesma área."
        },
        {
          "key": "E",
          "text": "Verificar somente o percentual de crescimento do calado."
        }
      ],
      "correct_answer": "B",
      "explanation": "O § 3.2 exige verificar a continuidade da conformidade quando reparos ou modificações em navio abrangido puderem afetar sua manobrabilidade, a juízo da Administração.",
      "source": {
        "author": "INTERNATIONAL MARITIME ORGANIZATION (IMO)",
        "title": "Standards for Ship Manoeuvrability",
        "edition": "Resolution MSC.137(76), 4 Dec. 2002",
        "locator": "Anexo 6, p. 2, §§ 3.1–3.2"
      },
      "tags": [
        "curva de giro",
        "IMO",
