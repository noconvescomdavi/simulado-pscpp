    {
      "id": "MAN-646",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.3",
      "topic": "Diâmetro tático",
      "difficulty": "Fácil",
      "style": "Situacional",
      "question": "Uma antena está 8 m a boreste do ponto de meia-nau. Em uma curva a boreste, o deslocamento transversal da antena, da ordem de leme até a mudança de proa de 180°, foi 574 m para boreste do rumo inicial. Qual é o diâmetro tático da meia-nau?",
      "options": [
        {
          "key": "A",
          "text": "558 m."
        },
        {
          "key": "B",
          "text": "566 m."
        },
        {
          "key": "C",
          "text": "574 m."
        },
        {
          "key": "D",
          "text": "582 m."
        },
        {
          "key": "E",
          "text": "590 m."
        }
      ],
      "correct_answer": "E",
      "explanation": "No eixo transversal original, a antena começa 8 m à direita da meia-nau e termina 8 m à esquerda, pois o casco girou 180°. O deslocamento da antena é 16 m menor que o da meia-nau. Somam-se 16 m a 574 m.",
      "source": {
        "author": "INTERNATIONAL MARITIME ORGANIZATION (IMO)",
        "title": "Standards for Ship Manoeuvrability",
