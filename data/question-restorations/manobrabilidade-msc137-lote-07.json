    {
      "id": "MAN-857",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.2",
      "topic": "Avanço",
      "difficulty": "Fácil",
      "style": "Aplicada",
      "question": "Uma antena está 12 m à vante do ponto de meia-nau, na linha de centro. Da ordem de leme à mudança de proa de 90°, a antena avançou 388 m na direção do rumo original. Quanto avançou o ponto de meia-nau nesse eixo?",
      "options": [
        {
          "key": "A",
          "text": "376 m."
        },
        {
          "key": "B",
          "text": "400 m."
        },
        {
          "key": "C",
          "text": "388 m."
        },
        {
          "key": "D",
          "text": "412 m."
        },
        {
          "key": "E",
          "text": "364 m."
        }
      ],
      "correct_answer": "B",
      "explanation": "No início, a antena está 12 m à frente no eixo original. Aos 90°, seu afastamento passa a ser perpendicular a esse eixo. Assim, a leitura da antena subestima o avanço da meia-nau em 12 m.",
      "source": {
        "author": "INTERNATIONAL MARITIME ORGANIZATION (IMO)",
        "title": "Standards for Ship Manoeuvrability",
        "edition": "Resolution MSC.137(76), 4 Dec. 2002",
