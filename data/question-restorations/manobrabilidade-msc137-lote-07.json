    {
      "id": "MAN-858",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.3",
      "topic": "Diâmetro tático",
      "difficulty": "Fácil",
      "style": "Aplicada",
      "question": "No eixo transversal de uma curva, a meia-nau está em +40 m quando se dá a ordem de leme e em +765 m quando a proa muda 180°. Para L = 145 m, qual é o resultado do critério de diâmetro tático?",
      "options": [
        {
          "key": "A",
          "text": "O diâmetro coincide com o máximo."
        },
        {
          "key": "B",
          "text": "O diâmetro excede o máximo em 40 m."
        },
        {
          "key": "C",
          "text": "O diâmetro excede o máximo em 80 m."
        },
        {
          "key": "D",
          "text": "O diâmetro fica 72,5 m abaixo do máximo."
        },
        {
          "key": "E",
          "text": "O diâmetro fica 40 m abaixo do máximo."
        }
      ],
      "correct_answer": "A",
      "explanation": "O diâmetro é a diferença 765 − 40 = 725 m. O máximo é 5 × 145 = 725 m, de modo que a leitura satisfaz o limite por igualdade.",
      "source": {
        "author": "INTERNATIONAL MARITIME ORGANIZATION (IMO)",
        "title": "Standards for Ship Manoeuvrability",
        "edition": "Resolution MSC.137(76), 4 Dec. 2002",
        "locator": "Anexo 6, p. 3, § 4.2.4, e p. 5, § 5.3.1"
