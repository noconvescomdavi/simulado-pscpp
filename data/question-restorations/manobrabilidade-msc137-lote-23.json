    {
      "id": "MAN-2218",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.30",
      "topic": "Avanço na curva de giro",
      "difficulty": "Médio",
      "style": "Situacional",
      "question": "No marco de 90° de mudança de proa, a meia-nau está 400 m em linha reta da posição da ordem de leme. A separação perpendicular à proa inicial é de 112 m. Sabendo que a meia-nau ainda está adiante da origem nesse eixo, qual é o avanço?",
      "options": [
        {
          "key": "A",
          "text": "112 m."
        },
        {
          "key": "B",
          "text": "288 m."
        },
        {
          "key": "C",
          "text": "384 m."
        },
        {
          "key": "D",
          "text": "400 m."
        },
        {
          "key": "E",
          "text": "512 m."
        }
      ],
      "correct_answer": "C",
      "explanation": "A distância de 400 m é a hipotenusa e os dois deslocamentos são ortogonais. A componente longitudinal vale √(400² − 112²) = 384 m.",
      "source": {
        "author": "INTERNATIONAL MARITIME ORGANIZATION (IMO)",
        "title": "Standards for Ship Manoeuvrability",
        "edition": "Resolution MSC.137(76), 4 Dec. 2002",
        "locator": "Anexo 6, p. 3, § 4.2.3"
      },
