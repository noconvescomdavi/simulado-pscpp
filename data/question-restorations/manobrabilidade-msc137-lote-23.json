    {
      "id": "MAN-2219",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.31",
      "topic": "Diâmetro tático",
      "difficulty": "Médio",
      "style": "Situacional",
      "question": "Um navio de L = 140 m apresenta raio de giro permanente de 260 m. No marco de proa exigido para o diâmetro tático, a distância perpendicular ao eixo inicial, desde a ordem de leme, é de 705 m. Qual é o resultado pelo critério de diâmetro tático?",
      "options": [
        {
          "key": "A",
          "text": "Atende com margem de 180 m, pois o valor é 520 m."
        },
        {
          "key": "B",
          "text": "Atende com margem de 5 m, pois o limite é 710 m."
        },
        {
          "key": "C",
          "text": "Excede por 75 m, pois o limite é 4,5 L."
        },
        {
          "key": "D",
          "text": "Excede por 5 m, pois o valor medido é 705 m e o limite é 700 m."
        },
        {
          "key": "E",
          "text": "Excede por 445 m, pois deve comparar 705 m diretamente ao raio."
        }
      ],
      "correct_answer": "D",
      "explanation": "A resolução usa a separação transversal aos 180° e fixa o máximo em 5 L. O valor de 705 m supera em 5 m o limite de 700 m. O raio em regime caracteriza outra grandeza.",
      "source": {
        "author": "INTERNATIONAL MARITIME ORGANIZATION (IMO)",
        "title": "Standards for Ship Manoeuvrability",
        "edition": "Resolution MSC.137(76), 4 Dec. 2002",
