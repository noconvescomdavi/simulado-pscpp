    {
      "id": "MAN-2220",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.32",
      "topic": "Zigue-zague",
      "difficulty": "Difícil",
      "style": "Situacional",
      "question": "Antes da primeira execução do zigue-zague 10°/10°, o registrador já indica uma guinada sustentada, embora a velocidade esteja estabilizada. Que condição ainda deve ser satisfeita para iniciar a prova padrão?",
      "options": [
        {
          "key": "A",
          "text": "Aumentar a taxa inicial até a correspondente ao leme a 10°."
        },
        {
          "key": "B",
          "text": "Aplicar a primeira inversão antes de ajustar a proa inicial."
        },
        {
          "key": "C",
          "text": "Esperar até o navio completar uma volta."
        },
        {
          "key": "D",
          "text": "Manter a guinada, desde que esteja para o bordo da primeira ordem."
        },
        {
          "key": "E",
          "text": "Estabilizar a aproximação sem rotação em torno do eixo vertical."
        }
      ],
      "correct_answer": "E",
      "explanation": "A sequência normalizada começa a partir de aproximação estabilizada com taxa de guinada nula. Velocidade estabilizada, sozinha, não atende a esse requisito.",
      "source": {
        "author": "INTERNATIONAL MARITIME ORGANIZATION (IMO)",
        "title": "Standards for Ship Manoeuvrability",
        "edition": "Resolution MSC.137(76), 4 Dec. 2002",
