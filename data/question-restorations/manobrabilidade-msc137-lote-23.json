    {
      "id": "MAN-2221",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.33",
      "topic": "Primeiro sobressinal",
      "difficulty": "Fácil",
      "style": "Situacional",
      "question": "Dois navios apresentam primeiro sobressinal de 12° no zigue-zague 10°/10°. Em X, L/V = 9 s. Em Y, L/V = 14 s. Qual decisão vale especificamente para esse primeiro sobressinal?",
      "options": [
        {
          "key": "A",
          "text": "X excede e Y fica no limite."
        },
        {
          "key": "B",
          "text": "X e Y excedem por 2°."
        },
        {
          "key": "C",
          "text": "X fica no limite e Y excede."
        },
        {
          "key": "D",
          "text": "X e Y ficam no limite."
        },
        {
          "key": "E",
          "text": "X atende e Y excede por 2°."
        }
      ],
      "correct_answer": "A",
      "explanation": "Para 9 s, o máximo é 10°. Para 14 s, usa-se 5 + 0,5 × 14 = 12°. Assim, X excede por 2° e Y atende no limite.",
      "source": {
        "author": "INTERNATIONAL MARITIME ORGANIZATION (IMO)",
        "title": "Standards for Ship Manoeuvrability",
        "edition": "Resolution MSC.137(76), 4 Dec. 2002",
