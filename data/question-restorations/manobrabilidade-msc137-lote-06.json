    {
      "id": "MAN-751",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.2",
      "topic": "Avanço",
      "difficulty": "Médio",
      "style": "Conceitual",
      "question": "Na proa inicial 030°, a meia-nau, ao atingir 90° de mudança de proa, estava 300 m a leste e 400 m ao norte da posição da ordem de leme. Qual é o avanço, arredondado ao metro?",
      "options": [
        {
          "key": "A",
          "text": "150 m."
        },
        {
          "key": "B",
          "text": "346 m."
        },
        {
          "key": "C",
          "text": "500 m."
        },
        {
          "key": "D",
          "text": "496 m."
        },
        {
          "key": "E",
          "text": "60 m."
        }
      ],
      "correct_answer": "D",
      "explanation": "A projeção na direção 030° é 300 × sen(30°) + 400 × cos(30°), aproximadamente 496 m.",
      "source": {
        "author": "INTERNATIONAL MARITIME ORGANIZATION (IMO)",
        "title": "Standards for Ship Manoeuvrability",
        "edition": "Resolution MSC.137(76), 4 Dec. 2002",
        "locator": "Anexo 6, p. 3, § 4.2.3"
      },
      "tags": [
