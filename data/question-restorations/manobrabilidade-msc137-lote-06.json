    {
      "id": "MAN-752",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.3",
      "topic": "Diâmetro tático",
      "difficulty": "Médio",
      "style": "Conceitual",
      "question": "Para duas curvas de giro de um navio de L = 110 m, o deslocamento no eixo lateral original aos 180° foi +550 m a boreste e −572 m a bombordo. Qual é o resultado do critério de diâmetro tático?",
      "options": [
        {
          "key": "A",
          "text": "Ambas as curvas atendem."
        },
        {
          "key": "B",
          "text": "Ambas excedem o limite."
        },
        {
          "key": "C",
          "text": "Somente a segunda atende."
        },
        {
          "key": "D",
          "text": "Somente a primeira atende."
        },
        {
          "key": "E",
          "text": "O sinal negativo impede avaliar bombordo."
        }
      ],
      "correct_answer": "D",
      "explanation": "O limite é 5 × 110 = 550 m. O sinal indica o lado. Os módulos são 550 m e 572 m, portanto só boreste atende.",
      "source": {
        "author": "INTERNATIONAL MARITIME ORGANIZATION (IMO)",
        "title": "Standards for Ship Manoeuvrability",
        "edition": "Resolution MSC.137(76), 4 Dec. 2002",
        "locator": "Anexo 6, p. 3, § 4.2.4, e p. 5, § 5.3.1"
      },
