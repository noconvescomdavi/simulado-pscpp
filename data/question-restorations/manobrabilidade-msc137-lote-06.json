    {
      "id": "MAN-803",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.1",
      "topic": "Curva de giro",
      "difficulty": "Difícil",
      "style": "Situacional",
      "question": "A prova de giro tem um traçado da trajetória da popa e um da meia-nau. Os dois traçados estão sincronizados com a ordem de leme. Qual deve ser usado para calcular as medidas padronizadas de giro?",
      "options": [
        {
          "key": "A",
          "text": "O traçado do ponto médio entre as perpendiculares."
        },
        {
          "key": "B",
          "text": "O traçado da popa para ambas as medidas."
        },
        {
          "key": "C",
          "text": "O traçado da popa para o avanço e o outro para o diâmetro."
        },
        {
          "key": "D",
          "text": "Um traçado obtido pela média das duas curvas registradas."
        },
        {
          "key": "E",
          "text": "O traçado que tiver a maior extensão total."
        }
      ],
      "correct_answer": "A",
      "explanation": "O avanço e o diâmetro tático se referem à meia-nau, definida na linha de centro a meio caminho entre as perpendiculares. Os deslocamentos da popa diferem dos da meia-nau durante a rotação.",
      "source": {
        "author": "INTERNATIONAL MARITIME ORGANIZATION (IMO)",
        "title": "Standards for Ship Manoeuvrability",
        "edition": "Resolution MSC.137(76), 4 Dec. 2002",
