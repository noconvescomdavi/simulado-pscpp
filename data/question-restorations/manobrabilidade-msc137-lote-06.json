    {
      "id": "MAN-753",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.4",
      "topic": "Zigue-zague",
      "difficulty": "Fácil",
      "style": "Conceitual",
      "question": "No zigue-zague 10°/10°, o primeiro comando foi 10° a bombordo a partir da proa 080°. Em que proas devem ocorrer a primeira e a segunda inversões de leme, respectivamente?",
      "options": [
        {
          "key": "A",
          "text": "070° e 090°."
        },
        {
          "key": "B",
          "text": "070° e 080°."
        },
        {
          "key": "C",
          "text": "090° e 070°."
        },
        {
          "key": "D",
          "text": "060° e 100°."
        },
        {
          "key": "E",
          "text": "080° e 090°."
        }
      ],
      "correct_answer": "A",
      "explanation": "As duas proas de inversão estão 10° de cada lado da referência original. A primeira fica a bombordo, em 070°, e a segunda a boreste, em 090°.",
      "source": {
