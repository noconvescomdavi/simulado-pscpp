  "questions": [
    {
      "id": "MAN-750",
      "subject": "Manobrabilidade do Navio",
      "module": "4. Controlabilidade e padrões de manobrabilidade",
      "topic_code": "4.1",
      "topic": "Curva de giro",
      "difficulty": "Médio",
      "style": "Conceitual",
      "question": "Uma falha encerrou o registro da curva de giro aos 120° de alteração de proa. Há posições de meia-nau desde a ordem de leme. Qual parte do critério pode ser apurada apenas com esses dados?",
      "options": [
        {
          "key": "A",
          "text": "O diâmetro tático, mas não o avanço."
        },
        {
          "key": "B",
          "text": "O avanço e o diâmetro tático."
        },
        {
          "key": "C",
          "text": "Nenhuma das duas medidas, pois ambas exigem 360°."
        },
        {
          "key": "D",
          "text": "O avanço, mas não o diâmetro tático."
        },
        {
          "key": "E",
          "text": "A distância de parada em marcha a ré."
        }
      ],
      "correct_answer": "D",
      "explanation": "A posição aos 90° basta para medir a projeção longitudinal do avanço a partir da ordem. O registro não alcança os 180° necessários ao diâmetro tático.",
      "source": {
        "author": "INTERNATIONAL MARITIME ORGANIZATION (IMO)",
        "title": "Standards for Ship Manoeuvrability",
        "edition": "Resolution MSC.137(76), 4 Dec. 2002",
        "locator": "Anexo 6, p. 3, §§ 4.2.2–4.2.4, e p. 5, § 5.3.1"
      },
