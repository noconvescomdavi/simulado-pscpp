  "questions": [
    {
      "id": "MAN-079",
      "subject": "Manobrabilidade do Navio",
      "module": "2. Propulsão do navio e propulsores",
      "topic_code": "6.1",
      "topic": "Skew",
      "difficulty": "Médio",
      "style": "Aplicada",
      "question": "Dois desenhos de pás diferem apenas na posição circunferencial dos pontos médios das cordas ao longo do raio. No segundo desenho, a linha desses pontos se curva para trás relativamente ao sentido de rotação. O que se espera ao comparar os hélices numa esteira axial muito desigual?",
      "options": [
        {
          "key": "A",
          "text": "Aumento da folga axial por inclinação do plano da pá."
        },
        {
          "key": "B",
          "text": "Eliminação da esteira a montante do disco."
        },
        {
          "key": "C",
          "text": "Passagem mais simultânea das seções radiais pelo setor de maior déficit de velocidade."
        },
        {
          "key": "D",
          "text": "Distribuição da passagem das seções por esse setor e possível redução dos picos de vibração induzida."
        },
        {
          "key": "E",
          "text": "Supressão do passo geométrico nas seções deslocadas."
        }
      ],
      "correct_answer": "D",
      "explanation": "O skew para trás altera a posição angular das seções ao longo do raio. Elas podem atravessar o setor de esteira mais intensa em momentos diferentes. Bertram associa essa geometria à redução dos picos de vibração induzida pelo hélice em esteira muito não uniforme.",
      "source": {
        "author": "BERTRAM, Volker",
        "title": "Practical Ship Hydrodynamics",
        "edition": "2. ed., 2012",
        "locator": "Cap. 2, § 2.1, pp. 42–43, fig. 2.1"
      },
      "tags": [
