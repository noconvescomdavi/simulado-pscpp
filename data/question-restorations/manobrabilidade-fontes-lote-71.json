    {
      "id": "MAN-085",
      "subject": "Manobrabilidade do Navio",
      "module": "2. Propulsão do navio e propulsores",
      "topic_code": "6.2",
      "topic": "Curvas de água aberta",
      "difficulty": "Médio",
      "style": "Cálculo",
      "question": "Na avaliação de um diagrama de água aberta, o ponto X tem J = 0,60, Kₜ = 0,20 e KQ = 0,042. O ponto Y tem J = 0,80, Kₜ = 0,16 e KQ = 0,040. Os valores de KQ são os próprios coeficientes. Qual comparação das eficiências em água aberta é compatível com esses dados?",
      "options": [
        {
          "key": "A",
          "text": "X tem maior eficiência porque Kₜ é maior."
        },
        {
          "key": "B",
          "text": "Y tem menor eficiência porque KQ é menor."
        },
        {
          "key": "C",
          "text": "X tem maior eficiência porque J é menor."
        },
        {
          "key": "D",
          "text": "Y tem eficiência menor, pois o torque dimensional aumenta em qualquer condição."
        },
        {
          "key": "E",
          "text": "Y tem maior eficiência pela razão entre o produto J Kₜ e KQ."
        }
      ],
      "correct_answer": "E",
      "explanation": "A eq. (2.3) dá η₀ = J Kₜ/(2π KQ). Para X, 0,120/(2π × 0,042) ≈ 0,455. Para Y, 0,128/(2π × 0,040) ≈ 0,509.",
      "source": {
        "author": "BERTRAM, Volker",
        "title": "Practical Ship Hydrodynamics",
        "edition": "2. ed., 2012",
