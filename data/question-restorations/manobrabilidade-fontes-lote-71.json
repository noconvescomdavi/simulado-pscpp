    {
      "id": "MAN-084",
      "subject": "Manobrabilidade do Navio",
      "module": "2. Propulsão do navio e propulsores",
      "topic_code": "6.1",
      "topic": "Número de avanço",
      "difficulty": "Médio",
      "style": "Cálculo",
      "question": "Um ensaio é repetido com velocidade incidente 20% maior e diâmetro 10% maior. Para preservar o número de avanço entre as duas condições, por qual fator a rotação do novo hélice deve ser multiplicada em relação à original?",
      "options": [
        {
          "key": "A",
          "text": "0,92."
        },
        {
          "key": "B",
          "text": "1,00."
        },
        {
          "key": "C",
          "text": "1,20."
        },
        {
          "key": "D",
          "text": "1,09."
        },
        {
          "key": "E",
          "text": "1,32."
        }
      ],
      "correct_answer": "D",
      "explanation": "Para preservar J = VA/(nD), a razão de rotações deve ser a razão de velocidades dividida pela de diâmetros. O fator é 1,20/1,10, aproximadamente 1,09.",
      "source": {
        "author": "BERTRAM, Volker",
        "title": "Practical Ship Hydrodynamics",
        "edition": "2. ed., 2012",
