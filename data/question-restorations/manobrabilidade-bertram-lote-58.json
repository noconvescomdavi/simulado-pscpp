    {
      "id": "MAN-B003-09",
      "subject": "I — Manobrabilidade do Navio",
      "module": "cavitação",
      "topic_code": "MAN.B003.09",
      "topic": "cavitação",
      "difficulty": "Difícil",
      "style": "Assertivas",
      "pscpp_format": "assertions",
      "cognitive_level": 3,
      "question": "Classifique as afirmações sobre cavitação e interação casco-hélice e assinale a combinação correta.",
      "assertions": [
        "I) A cavitação nas pás independe da pressão local.",
        "II) A fração de esteira w é dada por 1 − Vₐ/Vₛ, com Vₐ na entrada do hélice e Vₛ a velocidade do navio.",
        "III) O fator de dedução de empuxo t relaciona empuxo T e resistência Rₜ pela expressão T(1 − t) = Rₜ.",
        "IV) A esteira nominal corresponde ao escoamento no plano do hélice na ausência do propulsor."
      ],
      "options": [
        {
          "key": "A",
          "text": "Apenas I e III."
        },
        {
          "key": "B",
          "text": "Apenas I, II, III e IV."
        },
        {
          "key": "C",
          "text": "Apenas I e II."
        },
        {
          "key": "D",
          "text": "Apenas II, III e IV."
        },
        {
          "key": "E",
          "text": "Apenas I e IV."
        }
      ],
      "correct_answer": "D",
      "explanation": "I é falsa: cavitação depende de pressão local suficientemente baixa. II é verdadeira pela eq. (3.4), III pela eq. (3.3) e IV pela definição de esteira nominal. A, B, C e E incluem I. D contém todas as verdadeiras.",
      "active": true,
      "validation_status": "approved",
      "taxonomy": {
        "subject_id": "I",
        "subject_slug": "manobrabilidade",
        "bibliography_id": "bertram",
        "chapter_id": "bertram::ch2",
