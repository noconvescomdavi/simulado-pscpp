  B: svg(`<polygon points="4,4 92,4 68,50 92,96 4,96" fill="#d8222a"/>`, "0 0 96 100"),
  C: stripes(["#1769aa", "#fff", "#d8222a", "#fff", "#1769aa"], "h"),
