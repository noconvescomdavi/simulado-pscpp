{
  "name": "simulados-pscpp",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check:repo": "node scripts/check-repo-hygiene.mjs",
    "validate:questions": "node scripts/validate-question-banks.mjs",
    "test:question-structure": "node scripts/test-question-structure.mjs",
    "validate:taxonomy:master": "node scripts/validate-question-taxonomy.mjs",
    "validate:taxonomy:arte-naval": "node scripts/validate-arte-naval-taxonomy.mjs",
    "validate:taxonomy": "npm run validate:taxonomy:master && npm run validate:taxonomy:arte-naval",
    "validate": "npm run check:repo && npm run validate:questions && npm run test:question-structure && npm run validate:taxonomy && npm run audit:pscpp && npm run validate:historical-blueprint && npm run validate:learning-migrations && npm run build",
    "validate:historical-blueprint": "node scripts/validate-historical-exam-blueprint.mjs",
    "import:manobrabilidade": "node scripts/import-manobrabilidade.mjs",
    "validate:questions:all": "npm run validate:questions && npm run validate:taxonomy",
    "security:audit": "npm audit --audit-level=high",
    "validate:study-plan": "node scripts/validate-study-plan-v3.mjs",
    "test:learning": "node scripts/test-learning-algorithms.mjs",
    "validate:learning-migrations": "node scripts/validate-learning-migrations.mjs",
    "validate:drive-library": "node scripts/validate-drive-library.mjs",
    "audit:pscpp": "node scripts/audit-pscpp-bank.mjs",
    "audit:pscpp:final": "PSCPP_FINAL_AUDIT=1 node scripts/audit-pscpp-bank.mjs",
    "audit:questions:semantic": "node scripts/audit-question-semantics.mjs",
    "audit:questions:full": "node scripts/audit-full-question-bank.mjs",
    "validate:questions:full": "npm run validate:questions && npm run audit:questions:semantic && npm run audit:questions:full",
    "audit:questions:main": "QUESTIONS_MAIN_ONLY=1 node scripts/audit-full-question-bank.mjs",
    "audit:questions:main:win": "set QUESTIONS_MAIN_ONLY=1&& node scripts/audit-full-question-bank.mjs",
    "build:cloudflare": "opennextjs-cloudflare build",
    "deploy:cloudflare": "opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "jose": "^5.9.6",
    "next": "^15.5.2",
    "pg": "^8.13.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "@opennextjs/cloudflare": "1.20.6"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "postcss": "8.5.28"
  },
  "devDependencies": {
    "wrangler": "^4.125.0"
  }
}
